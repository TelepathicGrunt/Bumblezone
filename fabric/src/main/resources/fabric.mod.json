{
    "schemaVersion": 1,
    "id": "${mod_id}",
    "version": "${version}",

    "name": "${mod_display_name}",
    "description": "${mod_description}",
    "authors": [
        "${mod_author}"
    ],
    "contact": {
        "homepage": "${homepage_url_fabric}",
        "sources": "${sources_url}",
        "issues": "${issues_url}"
    },

    "license": "${license}",
    "icon": "${logo_fabric}",

    "environment": "*",
    "entrypoints": {
        "main": [
            "com.telepathicgrunt.the_bumblezone.fabric.BumblezoneFabric"
        ],
        "client": [
            "com.telepathicgrunt.the_bumblezone.fabric.BumblezoneFabricClient"
        ],
        "server": [
            "com.telepathicgrunt.the_bumblezone.fabric.BumblezoneFabricServer"
        ],
        "modmenu": [
            "com.telepathicgrunt.the_bumblezone.configs.fabric.ModMenuCompat"
        ],
        "cardinal-components-entity": [
            "com.telepathicgrunt.the_bumblezone.modules.fabric.ComponentInitializer"
        ],
        "emi": [
          "com.telepathicgrunt.the_bumblezone.modcompat.fabric.EMICompat"
        ],
        "rei_client": [
            "com.telepathicgrunt.the_bumblezone.modcompat.REICompat"
        ],
        "jei_mod_plugin": [
            "com.telepathicgrunt.the_bumblezone.modcompat.JEIIntegration"
        ]
    },
    "mixins": [
        "the_bumblezone-fabric.mixins.json",
        "the_bumblezone-common.mixins.json"
    ],
    "depends": {
        "fabricloader": ">=0.14.25",
        "minecraft": ">=1.20",
        "fabric": ">=0.83.0",
        "midnightlib": ">=1.4.0"
    },
    "breaks": {
        "structureessentials": "=1.20.1-4.5"
    }
}