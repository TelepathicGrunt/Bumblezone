{
    "schemaVersion": 1,
    "id": "${mod_id}",
    "version": "${version}",
    "name": "${mod_display_name}",
    "description": "${mod_description}",
    "authors": [
        "TelepathicGrunt"
    ],
    "contact": {
        "homepage": "${homepage_url}",
        "sources": "${sources_url}",
        "issues": "${issues_url}"
    },

    "license": "LGPLv3",
    "icon": "assets/the_bumblezone/the_bumblezone_logo_small.png",

    "environment": "*",
    "entrypoints": {
        "main": [
            "com.telepathicgrunt.the_bumblezone.fabric.BumblezoneFabric"
        ],
        "client": [
            "com.telepathicgrunt.the_bumblezone.fabric.BumblezoneFabricClient"
        ],
        "server": [
            "com.telepathicgrunt.the_bumblezone.fabric.BumblezoneFabricServer"
        ],
        "modmenu": [
            "com.telepathicgrunt.the_bumblezone.configs.fabric.ModMenuCompat"
        ],
        "rei_client": [
            "com.telepathicgrunt.the_bumblezone.modcompat.REICompat"
        ],
        "jei_mod_plugin": [
            "com.telepathicgrunt.the_bumblezone.modcompat.JEIIntegration"
        ]
    },
    "mixins": [
        "${mod_id}-fabric.mixins.json",
        "${mod_id}-common.mixins.json"
    ],
    "accessWidener": "${mod_id}.accesswidener",

    "depends": {
        "java": ">=${java_version}",
        "fabricloader": ">=${fabric_loader_version}",
        "minecraft": ">=26.1-snapshot-1",
        "fabric": ">=0.100.6",
        "resourcefullib": ">=3.0.11",
        "midnightlib": "*"
    }
}